<!-- Project 1: Travel Webpage -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Webpage</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; margin: 0; padding: 0; }
        header { background: #008cba; color: white; padding: 1rem 0; text-align: center; }
        .container { padding: 1rem; }
        img { max-width: 100%; height: auto; border-radius: 10px; }
        .destination { margin: 1rem 0; }
        h2 { color: #005f73; }
    </style>
</head>
<body>
    <header>
        <h1>Explore the World</h1>
    </header>
    <div class="container">
        <div class="destination">
            <h2>Bali, Indonesia</h2>
            <p>Experience the serene beaches and vibrant culture of Bali.</p>
            <img src="https://via.placeholder.com/600x400" alt="Bali Beach">
        </div>
        <div class="destination">
            <h2>Kyoto, Japan</h2>
            <p>Discover ancient temples and breathtaking cherry blossoms.</p>
            <img src="https://via.placeholder.com/600x400" alt="Kyoto Temple">
        </div>
    </div>
</body>
</html>
